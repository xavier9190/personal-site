# ==============================================================================
# Personal Site (Hub Pessoal) — Variáveis de Ambiente
# Copie este arquivo para .env.local em desenvolvimento e configure os valores
# reais na Vercel e nos GitHub Actions Secrets para produção.
# ==============================================================================

# String de conexão PostgreSQL do Supabase (use o Transaction Pooler, porta 6543, com ?pgbouncer=true)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.example.supabase.co:6543/postgres?pgbouncer=true

# Segredo criptográfico para assinatura HMAC-SHA256 do cookie de sessão.
# Gere com: openssl rand -hex 32
AUTH_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32

# Credencial mestre de acesso único (senha forte ou PIN longo alfanumérico).
# Em produção (NODE_ENV=production), a ausência de APP_ACCESS_PIN ou AUTH_SECRET bloqueia 100% dos acessos (Fail-Closed).
APP_ACCESS_PIN=replace-with-strong-master-passphrase

# Duração padrão (em dias) da sessão de login quando não especificada (opções suportadas na UI: 7, 30, 90)
AUTH_SESSION_DAYS=30

# Teto máximo (em dias) permitido pelo servidor para a duração da sessão
AUTH_MAX_SESSION_DAYS=90

# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
